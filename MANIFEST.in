include README.md LICENSE DISCLAIMER.md CONTRIBUTING.md CHANGELOG.md
include requirements.txt pyproject.toml setup.py MANIFEST.in
recursive-include docs *.md
recursive-include tests *.py
recursive-include webui *.html
recursive-include desktop *.py
recursive-include vision_data *.npz *.json *.png
global-exclude __pycache__/* *.py[cod]
